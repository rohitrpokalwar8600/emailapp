<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - Email Sender App</title>
    <link rel="stylesheet" href="/style.css">
</head>

<body>
    <div class="container">
        <h1>Login</h1>
        <% if (error) { %>
            <p class="error">
                <%= error %>
            </p>
            <% } %>
                <form action="/login" method="POST">
                    <label for="username">Username:</label>
                    <input type="text" id="username" name="username" required>
                    <label for="password">Password:</label>
                    <input type="password" id="password" name="password" required>
                    <label for="emailUser">Email User:</label>
                    <input type="text" id="emailUser" name="emailUser" required>
                    <label for="emailPass">Email Pass:</label>
                    <input type="password" id="emailPass" name="emailPass" required>
                    <button type="submit">Login</button>
                </form>
    </div>
</body>

</html>